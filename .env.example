# Nenhuma variável é obrigatória para rodar o site: o modo demonstração funciona sem chave
# e a análise com documentos próprios usa a chave que a pessoa informa na tela (ADR-014).

# Opcional — só para rodar a suíte de testes (pytest) ou POST /api/analyze localmente.
# ANTHROPIC_API_KEY=

# Opcional — troca de provedor para testes gratuitos (ADR-009/ADR-010, docs/DECISIONS.md).
# LLM_PROVIDER=groq
# GROQ_API_KEY=

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
