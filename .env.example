# O modo demonstração funciona sem nenhuma variável (ADR-014).

# Código de acesso da gestão: libera a análise com documentos (ADR-015). Sem ela, a análise
# real fica desligada. Use um código longo e difícil de adivinhar; na Vercel, defina em
# Settings > Environment Variables.
# ADVERSIA_CODIGO_GESTAO=

# Opcional — só para rodar a suíte de testes (pytest) ou POST /api/analyze localmente.
# ANTHROPIC_API_KEY=

# Opcional — troca de provedor para testes gratuitos (ADR-009/ADR-010, docs/DECISIONS.md).
# LLM_PROVIDER=groq
# GROQ_API_KEY=

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
